<Application x:Class="LumiTasks.VisualPrototype.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/></Style>
  <Color x:Key="PurpleColor">#8753E8</Color>
  <SolidColorBrush x:Key="Purple" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="Ink" Color="#43326F"/>
  <SolidColorBrush x:Key="Muted" Color="#8D7FB1"/>
  <SolidColorBrush x:Key="SoftStroke" Color="#C7AFFB"/>
  <SolidColorBrush x:Key="SoftFill" Color="#F8F4FF"/>
  <LinearGradientBrush x:Key="VioletGradient" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#AE76FA" Offset="0"/>
   <GradientStop Color="#7C44DA" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#5A459C" Offset="0"/><GradientStop Color="#6E52AD" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassGradient" StartPoint="0,0" EndPoint="0.9,1">
   <GradientStop Color="#FDFBFF" Offset="0"/>
   <GradientStop Color="#EAE2FC" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="IslandGradient" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#283868" Offset="0"/>
   <GradientStop Color="#1D2347" Offset="0.56"/>
   <GradientStop Color="#3D2B69" Offset="1"/>
  </LinearGradientBrush>
  <DropShadowEffect x:Key="SoftShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.22" Color="#6C4DCE"/>
  <DropShadowEffect x:Key="GlowShadow" BlurRadius="17" ShadowDepth="0" Opacity="0.48" Color="#9C70FA"/>
  <Style x:Key="GlassButton" TargetType="Button">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Background" Value="#F3EDFF"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SoftStroke}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
   <Setter Property="Background" Value="{DynamicResource VioletGradient}"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#B490F5"/>
  </Style>
  <!-- Unified fully rounded segment pills, used only in navigation and display selectors. -->
  <Style x:Key="NavIdle" TargetType="Button" BasedOn="{StaticResource GlassButton}">
   <Setter Property="Background" Value="#FAF8FF"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="8,8"/>
   <Setter Property="Margin" Value="2,1"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="pill" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="28" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pill" Property="Background" Value="#EEE5FF"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="pill" Property="Opacity" Value="0.75"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="NavSelected" TargetType="Button" BasedOn="{StaticResource NavIdle}">
   <Setter Property="Background" Value="{DynamicResource VioletGradient}"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#B995FA"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="pill" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="28" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pill" Property="Opacity" Value="0.9"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="pill" Property="Opacity" Value="0.75"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="FormTextBox" TargetType="TextBox">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Background" Value="#FFFDFEFF"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SoftStroke}"/>
   <Setter Property="BorderThickness" Value="1.7"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <!-- Use the native WPF TextBox input surface for reliable click, IME and caret handling.
        Rounded borders are supplied by the surrounding XAML Border controls. -->
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="PillTab" TargetType="Button" BasedOn="{StaticResource GlassButton}">
   <Setter Property="Padding" Value="14,10"/>
   <Setter Property="Background" Value="#FAF8FF"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- Violet slider drawn with WPF parts, not a default gray Windows track. -->
  <Style x:Key="SlimTrackButton" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="6" CornerRadius="3"/></ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="GlassSlider" TargetType="Slider">
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Slider">
     <Grid Height="27">
      <Track x:Name="PART_Track" VerticalAlignment="Center" Margin="2,0,2,0">
       <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource Purple}" Style="{StaticResource SlimTrackButton}"/></Track.DecreaseRepeatButton>
       <Track.Thumb>
        <Thumb Width="18" Height="18" Cursor="Hand">
         <Thumb.Template><ControlTemplate TargetType="Thumb">
          <Ellipse Fill="{DynamicResource Purple}" Stroke="#EEDFFF" StrokeThickness="2" Effect="{StaticResource SoftShadow}"/>
         </ControlTemplate></Thumb.Template>
        </Thumb>
       </Track.Thumb>
       <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="#DCD1F6" Style="{StaticResource SlimTrackButton}"/></Track.IncreaseRepeatButton>
      </Track>
     </Grid>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <!-- Single-border glass selector: WPF ComboBox Popup reuses the same rounded vocabulary. -->
  <Style x:Key="GlassComboItem" TargetType="ComboBoxItem">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Padding" Value="13,9"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ComboBoxItem">
     <Border x:Name="ItemBody" Background="Transparent" CornerRadius="11" Margin="4,2" Padding="{TemplateBinding Padding}">
      <ContentPresenter VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="#E9DCFF"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="#D9C5FC"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="GlassCombo" TargetType="ComboBox">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Background" Value="{DynamicResource SoftFill}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SoftStroke}"/>
   <Setter Property="BorderThickness" Value="1.5"/>
   <Setter Property="ItemContainerStyle" Value="{StaticResource GlassComboItem}"/>
   <Setter Property="MaxDropDownHeight" Value="260"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <Border x:Name="OuterGlass" CornerRadius="13" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <Grid Margin="14,0,10,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="23"/></Grid.ColumnDefinitions>
         <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
         <Path Grid.Column="1" Data="M 2,4 L 7,9 L 12,4" Stroke="{DynamicResource Purple}" StrokeThickness="1.8" VerticalAlignment="Center" HorizontalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
       </Border>
       <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0" Focusable="False" Opacity="0" ClickMode="Press"
          IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"/>
       <Popup x:Name="Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=OuterGlass}" AllowsTransparency="True" StaysOpen="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
        <Border MinWidth="{Binding ActualWidth,ElementName=OuterGlass}" MaxHeight="270" Margin="1,5,9,14" CornerRadius="16" BorderThickness="1.4" BorderBrush="{DynamicResource SoftStroke}" Background="{DynamicResource SoftFill}" Effect="{StaticResource SoftShadow}">
         <ScrollViewer Padding="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OuterGlass" Property="BorderBrush" Value="{DynamicResource Purple}"/></Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="OuterGlass" Property="BorderBrush" Value="{DynamicResource Purple}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="GlassCheck" TargetType="CheckBox">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,4,0,4"/>
  </Style>
   <!-- Reuse the morning edition's compact text-left / violet slider-right interaction. -->
  <Style x:Key="SwitchRow" TargetType="CheckBox">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Height" Value="49"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="CheckBox">
     <Grid Background="Transparent">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="53"/></Grid.ColumnDefinitions>
      <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
      <Border x:Name="SwitchTrack" Grid.Column="1" Width="48" Height="27" CornerRadius="14" Background="#D8D1EA" HorizontalAlignment="Right" VerticalAlignment="Center">
       <Ellipse x:Name="SwitchThumb" Width="21" Height="21" Fill="White" HorizontalAlignment="Left" Margin="3,0" Effect="{StaticResource SoftShadow}"/>
      </Border>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Purple}"/>
       <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SwitchTrack" Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="ColorHueSlider" TargetType="Slider">
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Slider">
     <Grid Height="33">
      <Track x:Name="PART_Track" Margin="3,0" VerticalAlignment="Center">
       <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" Style="{StaticResource SlimTrackButton}"/></Track.DecreaseRepeatButton>
       <Track.Thumb><Thumb Width="23" Height="29" Cursor="Hand">
        <Thumb.Template><ControlTemplate TargetType="Thumb">
         <Border Width="22" Height="29" CornerRadius="11" Background="#FEFAFF" BorderThickness="2.5" BorderBrush="{DynamicResource Ink}" Effect="{StaticResource SoftShadow}"/>
        </ControlTemplate></Thumb.Template>
       </Thumb></Track.Thumb>
       <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" Style="{StaticResource SlimTrackButton}"/></Track.IncreaseRepeatButton>
      </Track>
     </Grid>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
</Application.Resources>
</Application>
