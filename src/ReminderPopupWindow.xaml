<Window x:Class="LumiTasks.VisualPrototype.ReminderPopupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LumiTasks 任务提醒" Width="424" Height="236" WindowStartupLocation="Manual"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 ShowInTaskbar="False" ShowActivated="False" Topmost="True" Loaded="Popup_Loaded">
 <Border Margin="8" CornerRadius="22" Background="{DynamicResource GlassGradient}"
         BorderBrush="{DynamicResource SoftStroke}" BorderThickness="1.8" Effect="{StaticResource SoftShadow}">
  <Grid Margin="19,15,19,17">
   <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="45"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
    <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource VioletGradient}" HorizontalAlignment="Left">
     <TextBlock Text="✦" FontSize="22" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="LumiTasks · 任务提醒" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource Ink}"/>
     <TextBlock Text="任务时间已到" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
    </StackPanel>
    <Button Grid.Column="2" Content="×" FontSize="20" Padding="0" Background="Transparent"
      BorderThickness="0" Style="{StaticResource GlassButton}" Click="Close_Click" ToolTip="关闭提醒"/>
   </Grid>
   <StackPanel Grid.Row="1" Margin="4,6,0,3">
    <TextBlock x:Name="TaskTitle" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="TaskMessage" FontSize="13" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0" MaxHeight="41"/>
   </StackPanel>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="SnoozeMinutes" Height="40" FontSize="13" Style="{StaticResource GlassCombo}" SelectedIndex="1">
     <ComboBoxItem Content="5 分钟" Tag="5"/><ComboBoxItem Content="10 分钟" Tag="10"/>
     <ComboBoxItem Content="15 分钟" Tag="15"/><ComboBoxItem Content="30 分钟" Tag="30"/>
    </ComboBox>
    <Button Grid.Column="1" Content="稍后提醒" Margin="9,0,9,0" Style="{StaticResource GlassButton}" Click="Snooze_Click" FontSize="13"/>
    <Button Grid.Column="2" Content="知道了" Style="{StaticResource PrimaryButton}" Click="Acknowledge_Click" FontSize="14"/>
   </Grid>
  </Grid>
 </Border>
</Window>
