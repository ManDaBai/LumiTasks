<Window x:Class="LumiTasks.VisualPrototype.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LumiTasks" Width="780" Height="490" Topmost="True"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
 Loaded="Window_Loaded" Closed="Window_Closed">
 <Grid>
  <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
   <Viewbox x:Name="IslandSizeHost" Width="690" Height="92" Stretch="Uniform" StretchDirection="Both" Margin="0,6,0,0">
   <Border Width="690" Height="92" CornerRadius="46"
           Background="{DynamicResource IslandGradient}" BorderBrush="#AD8EF5" BorderThickness="1.6"
           Effect="{StaticResource GlowShadow}" MouseLeftButtonDown="Island_MouseLeftButtonDown">
    <Grid Margin="27,0,20,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="46"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/>
     </Grid.ColumnDefinitions>
     <Border Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="7" BorderBrush="#E6E9FF" BorderThickness="2">
      <TextBlock Text="✓" FontSize="26" Foreground="#EFF8FF" HorizontalAlignment="Center" Margin="-1,-7,0,0"/>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
      <TextBlock Text="今日任务" FontSize="22" FontWeight="SemiBold" Foreground="#F9F7FF"/>
      <Border Height="5" Margin="0,6,0,0" Width="112" HorizontalAlignment="Left" Background="#454D81" CornerRadius="3">
       <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Background="#BF96FF" CornerRadius="3"/>
      </Border>
     </StackPanel>
     <TextBlock Grid.Column="2" x:Name="ProgressText" Text="0/0" FontSize="24" FontWeight="SemiBold" Foreground="#D3ADFF" VerticalAlignment="Center" Margin="18,0,0,0"/>
     <Button Grid.Column="4" Content="+" Width="53" Height="53" FontSize="30" Style="{StaticResource PrimaryButton}" Click="Add_Click"
             Padding="0" BorderThickness="1.5"/>
     <Button Grid.Column="5" x:Name="ExpandButton" Content="⌃" Width="53" Height="53" FontSize="30" Style="{StaticResource GlassButton}" Click="Expand_Click"
             Background="#59658D" Foreground="#F4F1FF" BorderBrush="#A5AAD0" Padding="0" ToolTip="展开 / 收起任务球"/>
    </Grid>
   </Border>
   </Viewbox>
   <StackPanel x:Name="OrbsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
  </StackPanel>
 </Grid>
</Window>
