<Window x:Class="LumiTasks.VisualPrototype.DrawerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LumiTasks"
 Width="590" Height="880" WindowStartupLocation="Manual" WindowStyle="None"
 AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
 Loaded="Window_Loaded">
 <Border Margin="9" Background="{DynamicResource GlassGradient}" BorderBrush="#BBA1F7" BorderThickness="2" CornerRadius="30" Effect="{StaticResource SoftShadow}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="85"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" CornerRadius="29,29,20,20" Background="{DynamicResource HeaderGradient}">
    <Grid Margin="34,0,25,0">
     <StackPanel VerticalAlignment="Center" Margin="22,0,0,0">
      <TextBlock Text="LumiTasks" FontSize="27" Foreground="White" FontWeight="SemiBold"/>
      <TextBlock Text="悬挂任务岛 · 每日计划与提醒" FontSize="13" Foreground="#E6DFFA" Margin="0,10,0,0"/>
     </StackPanel>
     <TextBlock Text="◇" FontSize="31" Foreground="#F5F0FF" VerticalAlignment="Center" HorizontalAlignment="Left"/>
     <Button Content="×" Width="39" Height="39" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,19,0,0" FontSize="23"
             Background="#8A76C2" Foreground="White" Style="{StaticResource GlassButton}" BorderThickness="0" Padding="0" Click="Close_Click"/>
    </Grid>
   </Border>
   <Border Grid.Row="1" CornerRadius="36" Background="#F5F1FF" BorderBrush="#A985F5" BorderThickness="1.8" Height="65" Margin="22,10,22,10">
    <UniformGrid Columns="3" Margin="6">
     <Button x:Name="TaskTab" Content="☑ 任务" Style="{StaticResource NavSelected}" Click="TaskTab_Click" FontSize="17"/>
     <Button x:Name="SettingTab" Content="⚙ 设置" Style="{StaticResource NavIdle}" Click="SettingTab_Click" FontSize="17"/>
     <Button x:Name="StatsTab" Content="▥ 统计" Style="{StaticResource NavIdle}" Click="StatsTab_Click" FontSize="17"/>
    </UniformGrid>
   </Border>
   <Grid Grid.Row="2" Margin="24,0,24,18">
    <ScrollViewer x:Name="TaskView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="5,9,5,6">
      <Grid Margin="0,2,0,16">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="任务管理" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Content="＋ 新增任务" Style="{StaticResource PrimaryButton}" Height="43" Click="NewTask_Click"/>
      </Grid>
      <Border CornerRadius="21" Background="#E6DCFA" Height="50" Margin="0,0,0,16">
       <UniformGrid Columns="2" Margin="5">
        <Button x:Name="TodayButton" Content="今天" Click="Today_Click" Style="{StaticResource PrimaryButton}"/>
        <Button x:Name="TomorrowButton" Content="明天" Click="Tomorrow_Click" Style="{StaticResource PillTab}"/>
       </UniformGrid>
      </Border>
      <StackPanel x:Name="TaskList"/>
     </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="EditorView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="3,8,3,15">
      <Grid Margin="0,0,0,18">
       <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
       <Button Content="‹ 返回" FontSize="13" Padding="0" Click="Return_Click" Style="{StaticResource GlassButton}" BorderThickness="0" Background="Transparent"/>
       <TextBlock Grid.Column="1" Text="新增任务" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
       <Button x:Name="DateBadge" Grid.Column="2" Content="今天" Style="{StaticResource GlassButton}" BorderThickness="0" Background="#E8DDFB" Click="DateBadge_Click"/>
      </Grid>
      <TextBlock Text="任务名称 *" Style="{StaticResource FieldLabel}"/>
      <!-- Native TextBox inside the existing rounded frame: no custom input template. -->
      <Border Height="49" Margin="0,0,0,16" CornerRadius="13"
              Background="#FFFDFEFF" BorderBrush="{DynamicResource SoftStroke}" BorderThickness="1.7">
       <TextBox x:Name="TaskName" Margin="2" Padding="12,0" BorderThickness="0" Background="Transparent"
                FontFamily="Microsoft YaHei UI" FontSize="17" FontWeight="Medium"
                Foreground="{DynamicResource Ink}" CaretBrush="#6D49C6" SelectionBrush="#C7AFFB"
                TextAlignment="Center" VerticalContentAlignment="Center"
                AcceptsReturn="False" TextWrapping="NoWrap" SpellCheck.IsEnabled="False"
                Focusable="True" IsTabStop="True"
                PreviewMouseLeftButtonDown="Input_PreviewMouseLeftButtonDown"/>
      </Border>
      <Grid Margin="0,0,0,16">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0">
        <TextBlock Text="提醒时间 (HH:MM)" Style="{StaticResource FieldLabel}"/>
        <Button x:Name="TimeButton" Height="46" Content="◷  选择时间  ⌄" Click="Time_Click" Style="{StaticResource GlassButton}"/>
        <Popup x:Name="TimePopup" PlacementTarget="{Binding ElementName=TimeButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
         <Border Width="266" Padding="15" Margin="1,7,6,14" Background="#F5EFFF" CornerRadius="20" BorderBrush="#C4A8F9" BorderThickness="1.6" Effect="{StaticResource SoftShadow}">
          <StackPanel>
           <UniformGrid Columns="3" Margin="0,0,0,11">
            <StackPanel Background="#E7DAFB">
             <Button Content="+" Style="{StaticResource PillTab}" Click="HourPlus_Click" FontSize="18"/>
             <TextBlock x:Name="HourText" Text="09" FontSize="34" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource Ink}" Margin="0,3"/>
             <Button Content="−" Style="{StaticResource PillTab}" Click="HourMinus_Click" FontSize="20"/>
            </StackPanel>
            <TextBlock Text=":" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#6D49C6"/>
            <StackPanel Background="#E7DAFB">
             <Button Content="+" Style="{StaticResource PillTab}" Click="MinutePlus_Click" FontSize="18"/>
             <TextBlock x:Name="MinuteText" Text="30" FontSize="34" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource Ink}" Margin="0,3"/>
             <Button Content="−" Style="{StaticResource PillTab}" Click="MinuteMinus_Click" FontSize="20"/>
            </StackPanel>
           </UniformGrid>
           <UniformGrid Columns="2">
            <Button Content="不提醒" Style="{StaticResource GlassButton}" Margin="0,0,4,0" Click="NoTime_Click"/>
            <Button Content="确定" Style="{StaticResource PrimaryButton}" Margin="4,0,0,0" Click="ConfirmTime_Click"/>
           </UniformGrid>
          </StackPanel>
         </Border>
        </Popup>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="预计时长（可不设置）" Style="{StaticResource FieldLabel}"/>
        <Button x:Name="DurationButton" Height="46" Content="◷  选择时长  ⌄"
                Click="Duration_Click" Style="{StaticResource GlassButton}"/>
        <Popup x:Name="DurationPopup" PlacementTarget="{Binding ElementName=DurationButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
         <Border Width="266" Padding="15" Margin="1,7,6,14" Background="#F5EFFF"
                 CornerRadius="20" BorderBrush="#C4A8F9" BorderThickness="1.6"
                 Effect="{StaticResource SoftShadow}">
          <StackPanel>
           <UniformGrid Columns="3" Margin="0,0,0,11">
            <StackPanel Background="#E7DAFB">
             <Button Content="+" Style="{StaticResource PillTab}" Click="DurationHourPlus_Click" FontSize="18"/>
             <TextBox x:Name="DurationHourText" Text="00" Height="44" TextAlignment="Center"
                      BorderThickness="0" Background="Transparent" FontFamily="Microsoft YaHei UI"
                      FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                      VerticalContentAlignment="Center" MaxLength="2"
                      PreviewTextInput="DurationDigits_PreviewTextInput"/>
             <Button Content="−" Style="{StaticResource PillTab}" Click="DurationHourMinus_Click" FontSize="20"/>
            </StackPanel>
            <TextBlock Text=":" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#6D49C6"/>
            <StackPanel Background="#E7DAFB">
             <Button Content="+" Style="{StaticResource PillTab}" Click="DurationMinutePlus_Click" FontSize="18"/>
             <TextBox x:Name="DurationMinuteText" Text="00" Height="44" TextAlignment="Center"
                      BorderThickness="0" Background="Transparent" FontFamily="Microsoft YaHei UI"
                      FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                      VerticalContentAlignment="Center" MaxLength="2"
                      PreviewTextInput="DurationDigits_PreviewTextInput"/>
             <Button Content="−" Style="{StaticResource PillTab}" Click="DurationMinuteMinus_Click" FontSize="20"/>
            </StackPanel>
           </UniformGrid>
           <UniformGrid Columns="2">
            <Button Content="不设置" Style="{StaticResource GlassButton}" Margin="0,0,4,0" Click="DurationNone_Click"/>
            <Button Content="确定" Style="{StaticResource PrimaryButton}" Margin="4,0,0,0" Click="DurationConfirm_Click"/>
           </UniformGrid>
          </StackPanel>
         </Border>
        </Popup>
       </StackPanel>
      </Grid>
      <TextBlock Text="重要程度" Style="{StaticResource FieldLabel}"/>
      <UniformGrid Columns="3" Margin="0,0,0,16" Height="46">
       <Button x:Name="NormalPriority" Content="普通" Click="PriorityNormal_Click" Style="{StaticResource PrimaryButton}"/>
       <Button x:Name="ImportantPriority" Content="重要" Click="PriorityImportant_Click" Style="{StaticResource GlassButton}" Background="#FCE7D7"/>
       <Button x:Name="UrgentPriority" Content="紧急" Click="PriorityUrgent_Click" Style="{StaticResource GlassButton}" Background="#FBDCE9"/>
      </UniformGrid>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="任务分类" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="CategoryCombo" Height="44" FontSize="16" Style="{StaticResource GlassCombo}" SelectionChanged="Category_Changed"/>
        <Button x:Name="DeleteCategoryButton" Content="删除自定义分类" Visibility="Collapsed"
                HorizontalAlignment="Right" Margin="0,5,0,0" Padding="8,3" FontSize="11"
                Style="{StaticResource GlassButton}" Click="DeleteCategory_Click"/>
       </StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="重复规则" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="RepeatCombo" Height="44" FontSize="16" Style="{StaticResource GlassCombo}"/>
       </StackPanel>
      </Grid>
      <Border x:Name="CustomCategoryBox" Visibility="Collapsed" CornerRadius="13" Padding="10" Background="#EEE7FE" BorderBrush="{DynamicResource SoftStroke}" BorderThickness="1" Margin="0,0,0,13">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
        <Border Height="39" CornerRadius="13" BorderThickness="1.7" BorderBrush="{DynamicResource SoftStroke}" Background="#FFFDFEFF">
         <TextBox x:Name="CustomCategoryName" Margin="2" BorderThickness="0" Background="Transparent" Padding="10,3"
                  FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource Ink}"
                  MaxLength="20" ToolTip="请输入自定义分类名称" Focusable="True" IsTabStop="True"
                  PreviewMouseLeftButtonDown="Input_PreviewMouseLeftButtonDown"/>
        </Border>
        <Button Grid.Column="1" Content="取消" Click="CancelCategory_Click" Style="{StaticResource GlassButton}" FontSize="12" Padding="0" Margin="4,0,0,0"/>
        <Button Grid.Column="2" Content="确定" Click="SaveCategory_Click" Style="{StaticResource PrimaryButton}" FontSize="12" Padding="0" Margin="4,0,0,0"/>
       </Grid>
      </Border>
      <TextBlock Text="提醒方式" Style="{StaticResource FieldLabel}"/>
      <UniformGrid Columns="3" Margin="0,0,0,16" Height="45">
       <Button x:Name="RemindBoth" Content="♧ 双重提醒" Click="ReminderBoth_Click" Style="{StaticResource PrimaryButton}" FontSize="12" Padding="0"/>
       <Button x:Name="RemindGlow" Content="✧ 球体高亮" Click="ReminderGlow_Click" Style="{StaticResource PillTab}" FontSize="12" Padding="0"/>
       <Button x:Name="RemindSystem" Content="桌面弹窗" Click="ReminderSystem_Click" Style="{StaticResource PillTab}" FontSize="12" Padding="0"/>
      </UniformGrid>
      <TextBlock Text="备注（可选）" Style="{StaticResource FieldLabel}"/>
      <Border Height="74" Margin="0,0,0,23" CornerRadius="13" BorderThickness="1.7"
              BorderBrush="{DynamicResource SoftStroke}" Background="#FFFDFEFF">
       <TextBox x:Name="TaskNotes" Margin="2" Padding="10,7" BorderThickness="0" Background="Transparent"
                Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="16"
                CaretBrush="#6D49C6" TextWrapping="Wrap" AcceptsReturn="True"
                VerticalContentAlignment="Top" PreviewMouseLeftButtonDown="Input_PreviewMouseLeftButtonDown"/>
      </Border>
      <UniformGrid Columns="2" Height="48">
       <Button Content="取消" Style="{StaticResource GlassButton}" Margin="0,0,5,0" Click="Return_Click"/>
       <Button Content="✓  保存任务" Style="{StaticResource PrimaryButton}" Margin="5,0,0,0" Click="SaveTask_Click"/>
      </UniformGrid>
     </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="7,9,7,15">
      <TextBlock Text="提醒与显示" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,2,0,14"/>
      <UniformGrid Columns="2" Height="44" Margin="0,0,0,17">
       <Button x:Name="AppearanceTab" Content="常用设置" Style="{StaticResource NavSelected}" Click="Appearance_Click" FontSize="14"/>
       <Button x:Name="MoreTab" Content="更多选项" Style="{StaticResource NavIdle}" Click="More_Click" FontSize="14"/>
      </UniformGrid>
      <StackPanel x:Name="AppearanceSection">
       <Border Background="{DynamicResource SoftFill}" CornerRadius="21" BorderThickness="1" BorderBrush="{DynamicResource SoftStroke}" Padding="19" Margin="0,0,0,12">
        <StackPanel>
         <TextBlock Text="▣  显示设置" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,18"/>
         <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="256"/></Grid.ColumnDefinitions>
          <TextBlock Text="顶部灵动岛大小" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
          <UniformGrid Grid.Column="1" Columns="3" Height="38">
           <Button x:Name="IslandSmall" Content="小" Style="{StaticResource PillTab}" Click="IslandSmall_Click"/>
           <Button x:Name="IslandMedium" Content="中" Style="{StaticResource PrimaryButton}" Click="IslandMedium_Click"/>
           <Button x:Name="IslandLarge" Content="大" Style="{StaticResource PillTab}" Click="IslandLarge_Click"/>
          </UniformGrid>
         </Grid>
         <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="256"/></Grid.ColumnDefinitions>
          <TextBlock Text="任务球大小" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
          <UniformGrid Grid.Column="1" Columns="3" Height="38">
           <Button x:Name="BallSmall" Content="小" Style="{StaticResource PillTab}" Click="BallSmall_Click"/>
           <Button x:Name="BallMedium" Content="中" Style="{StaticResource PrimaryButton}" Click="BallMedium_Click"/>
           <Button x:Name="BallLarge" Content="大" Style="{StaticResource PillTab}" Click="BallLarge_Click"/>
          </UniformGrid>
         </Grid>
         <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="245"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
          <TextBlock Text="透明度" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" x:Name="OpacitySlider" Style="{StaticResource GlassSlider}" Minimum="40" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="OpacitySlider_Changed"/>
          <TextBlock Grid.Column="2" x:Name="OpacityLabel" Text="100%" FontSize="14" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
         </Grid>
         <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="256"/></Grid.ColumnDefinitions>
          <TextBlock Text="吊线长度" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
          <UniformGrid Grid.Column="1" Columns="3" Height="38">
           <Button x:Name="WireShort" Content="短" Style="{StaticResource PillTab}" Click="WireShort_Click"/>
           <Button x:Name="WireMedium" Content="中" Style="{StaticResource PrimaryButton}" Click="WireMedium_Click"/>
           <Button x:Name="WireLong" Content="长" Style="{StaticResource PillTab}" Click="WireLong_Click"/>
          </UniformGrid>
         </Grid>
         <StackPanel>
          <Grid Margin="0,0,0,12">
           <TextBlock Text="主题风格" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
           <TextBlock x:Name="ThemeStatus" Text="默认 · 梦幻紫" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <Grid Margin="0,0,0,9">
           <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
           <Button x:Name="ThemeDefault" Content="默认" Style="{StaticResource GlassButton}" Click="ThemeDefault_Click" FontSize="13" Padding="0" Height="35"/>
           <Grid Grid.Column="1" Margin="12,0">
            <Border Height="17" CornerRadius="9" VerticalAlignment="Center">
             <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#EB6A74" Offset="0"/><GradientStop Color="#F3D16E" Offset="0.1667"/>
              <GradientStop Color="#64CB80" Offset="0.3333"/><GradientStop Color="#59CAD5" Offset="0.5"/>
              <GradientStop Color="#6688E9" Offset="0.6667"/><GradientStop Color="#9671EC" Offset="0.75"/>
              <GradientStop Color="#DA75DB" Offset="0.8333"/><GradientStop Color="#EB6A74" Offset="1"/>
             </LinearGradientBrush></Border.Background>
            </Border>
            <Slider x:Name="HueSlider" Style="{StaticResource ColorHueSlider}" Minimum="0" Maximum="359" Value="270" ValueChanged="HueSlider_Changed"/>
           </Grid>
           <Button Grid.Column="2" Content="随机" Style="{StaticResource GlassButton}" Click="ThemeRandom_Click" FontSize="13" Padding="0" Height="35"/>
          </Grid>
          <Border Background="#FFFDFEFF" CornerRadius="14" BorderBrush="{DynamicResource SoftStroke}" BorderThickness="1" Padding="11">
           <StackPanel>
            <Grid Margin="0,0,0,8">
             <TextBlock Text="实时主题预览" FontSize="12" Foreground="{DynamicResource Muted}"/>
             <Border HorizontalAlignment="Right" x:Name="ThemePreviewDot" Background="{DynamicResource Purple}" Width="16" Height="16" CornerRadius="8"/>
            </Grid>
            <Border Height="40" CornerRadius="11" Background="{DynamicResource HeaderGradient}" Padding="13,0">
             <Grid>
              <TextBlock Text="LumiTasks" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Border Background="{DynamicResource VioletGradient}" Width="48" Height="21" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Center">
               <Ellipse Width="17" Height="17" Fill="White" HorizontalAlignment="Right" Margin="2"/>
              </Border>
             </Grid>
            </Border>
           </StackPanel>
          </Border>
         </StackPanel>
        </StackPanel>
       </Border>
      </StackPanel>
      <StackPanel x:Name="BehaviorSection" Margin="0,0,0,12">
       <Border Background="{DynamicResource SoftFill}" BorderBrush="{DynamicResource SoftStroke}" BorderThickness="1" CornerRadius="21" Padding="20">
        <StackPanel>
         <TextBlock Text="▣  使用行为" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,14"/>
         <CheckBox x:Name="ShowTimeToggle" Content="显示任务球计时" Style="{StaticResource SwitchRow}" Checked="BehaviorToggle_Changed" Unchecked="BehaviorToggle_Changed"/>
         <CheckBox x:Name="ShowDoneToggle" Content="显示已完成状态" Style="{StaticResource SwitchRow}" Checked="BehaviorToggle_Changed" Unchecked="BehaviorToggle_Changed"/>
         <CheckBox x:Name="AutoCarryToggle" Content="未完成任务次日顺延" Style="{StaticResource SwitchRow}" Checked="BehaviorToggle_Changed" Unchecked="BehaviorToggle_Changed"/>
         <CheckBox x:Name="StartupToggle" Content="Windows 登录时启动" Style="{StaticResource SwitchRow}" Checked="BehaviorToggle_Changed" Unchecked="BehaviorToggle_Changed"/>
         <TextBlock Text="操作更改后自动保存；任务球主体仍用于开始／暂停计时。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
      <StackPanel x:Name="MoreSection" Visibility="Collapsed">
       <Border Background="{DynamicResource SoftFill}" BorderBrush="{DynamicResource SoftStroke}" BorderThickness="1" CornerRadius="21" Padding="20" Margin="0,0,0,12">
        <StackPanel>
         <TextBlock Text="▣  更多选项" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,16"/>
         <CheckBox x:Name="GlowToggle" Content="任务到点发光" Style="{StaticResource SwitchRow}" Checked="GlowToggle_Changed" Unchecked="GlowToggle_Changed"/>
         <Border Height="1" Background="{DynamicResource SoftStroke}" Margin="0,0,0,0"/>
         <CheckBox x:Name="NotifyToggle" Content="桌面弹窗通知" Style="{StaticResource SwitchRow}" Checked="NotifyToggle_Changed" Unchecked="NotifyToggle_Changed"/>
         <TextBlock Text="默认任务分类" Style="{StaticResource FieldLabel}" Margin="0,20,0,8"/>
         <ComboBox x:Name="DefaultCategoryCombo" Style="{StaticResource GlassCombo}" Height="45" SelectionChanged="DefaultCategory_Changed"/>
         <Button x:Name="DeleteDefaultCategoryButton" Content="删除自定义分类" Visibility="Collapsed"
                 HorizontalAlignment="Right" Margin="0,5,0,0" Padding="8,3" FontSize="11"
                 Style="{StaticResource GlassButton}" Click="DeleteDefaultCategory_Click"/>
         <Border x:Name="DefaultCustomCategoryBox" Visibility="Collapsed" CornerRadius="13" Padding="10" Background="#EEE7FE" BorderBrush="{DynamicResource SoftStroke}" BorderThickness="1" Margin="0,9,0,3">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
           <Border Height="39" CornerRadius="13" BorderThickness="1.7" BorderBrush="{DynamicResource SoftStroke}" Background="#FFFDFEFF">
            <TextBox x:Name="DefaultCustomCategoryName" Margin="2" BorderThickness="0" Background="Transparent" Padding="10,3"
                     FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource Ink}"
                     MaxLength="20" ToolTip="请输入自定义分类名称" Focusable="True" IsTabStop="True"
                     PreviewMouseLeftButtonDown="Input_PreviewMouseLeftButtonDown"/>
           </Border>
           <Button Grid.Column="1" Content="取消" Click="CancelDefaultCategory_Click" Style="{StaticResource GlassButton}" FontSize="12" Padding="0" Margin="4,0,0,0"/>
           <Button Grid.Column="2" Content="确定" Click="SaveDefaultCategory_Click" Style="{StaticResource PrimaryButton}" FontSize="12" Padding="0" Margin="4,0,0,0"/>
          </Grid>
         </Border>
         <TextBlock Text="提前提醒（分钟）" Style="{StaticResource FieldLabel}" Margin="0,17,0,8"/>
         <UniformGrid Columns="4" Height="42">
          <Button x:Name="Lead0" Content="不提前" Style="{StaticResource PrimaryButton}" Click="Lead0_Click"/>
          <Button x:Name="Lead5" Content="5 分钟" Style="{StaticResource PillTab}" Click="Lead5_Click"/>
          <Button x:Name="Lead10" Content="10 分钟" Style="{StaticResource PillTab}" Click="Lead10_Click"/>
          <Button x:Name="Lead15" Content="15 分钟" Style="{StaticResource PillTab}" Click="Lead15_Click"/>
         </UniformGrid>
        </StackPanel>
       </Border>
       <Border Background="{DynamicResource SoftFill}" BorderBrush="{DynamicResource SoftStroke}" BorderThickness="1" CornerRadius="21" Padding="20">
        <StackPanel>
         <TextBlock Text="数据管理" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,15"/>
         <UniformGrid Columns="2" Height="46">
          <Button Content="导出 JSON 备份" Style="{StaticResource GlassButton}" Margin="0,0,4,0" Click="Export_Click"/>
          <Button Content="导入 JSON 备份" Style="{StaticResource GlassButton}" Margin="4,0,0,0" Click="Import_Click"/>
         </UniformGrid>
         <TextBlock Text="数据仅保存到独立目录，不覆盖旧版任务文件。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="StatisticsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="8,10,8,18">
      <TextBlock Text="数据统计" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,16"/>
      <UniformGrid Columns="2" Margin="0,0,0,14">
       <Border Background="{DynamicResource SoftFill}" CornerRadius="19" Padding="19" BorderThickness="1" BorderBrush="{DynamicResource SoftStroke}" Margin="0,0,6,0">
        <StackPanel><TextBlock Text="今日任务" FontSize="14" Foreground="{DynamicResource Muted}"/>
         <TextBlock x:Name="StatisticsSummary" Text="0 / 0" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,9,0,0"/>
        </StackPanel>
       </Border>
       <Border Background="{DynamicResource SoftFill}" CornerRadius="19" Padding="19" BorderThickness="1" BorderBrush="{DynamicResource SoftStroke}" Margin="6,0,0,0">
        <StackPanel><TextBlock Text="今日完成率" FontSize="14" Foreground="{DynamicResource Muted}"/>
         <TextBlock x:Name="StatisticsRate" Text="0%" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,9,0,0"/>
        </StackPanel>
       </Border>
      </UniformGrid>
      <UniformGrid Columns="2" Margin="0,0,0,16">
       <Border Background="{DynamicResource SoftFill}" CornerRadius="19" Padding="19" BorderThickness="1" BorderBrush="{DynamicResource SoftStroke}" Margin="0,0,6,0">
        <StackPanel><TextBlock Text="累计专注时长" FontSize="14" Foreground="{DynamicResource Muted}"/>
         <TextBlock x:Name="StatisticsTime" Text="0 分钟" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,9,0,0"/>
        </StackPanel>
       </Border>
       <Border Background="{DynamicResource SoftFill}" CornerRadius="19" Padding="19" BorderThickness="1" BorderBrush="{DynamicResource SoftStroke}" Margin="6,0,0,0">
        <StackPanel><TextBlock Text="近七日完成" FontSize="14" Foreground="{DynamicResource Muted}"/>
         <TextBlock x:Name="StatisticsWeek" Text="0 / 0" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,9,0,0"/>
        </StackPanel>
       </Border>
      </UniformGrid>
      <Border Background="{DynamicResource SoftFill}" CornerRadius="21" BorderThickness="1" BorderBrush="{DynamicResource SoftStroke}" Padding="18">
       <StackPanel>
        <TextBlock Text="最近 7 天完成情况" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,18"/>
        <Grid x:Name="SevenDayChart" Height="180" Margin="8,0,8,0"/>
        <TextBlock x:Name="StatisticsEmpty" Text="尚无历史记录，完成任务后即可看到趋势。" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
 </Border>
</Window>
